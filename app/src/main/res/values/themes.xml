<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Личный небосвод — полностью тёмный (AMOLED) интерфейс.
        Тема намеренно тёмная, чтобы системные панели не создавали светлую
        полосу поверх чёрного небосвода на Android 15+ (edge-to-edge).
    -->
    <style name="Theme.PersonalSky" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/amoled_black</item>
        <item name="android:colorBackground">@color/amoled_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>